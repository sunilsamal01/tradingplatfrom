
NODE_ENV=development
CLIENT_URL=https://sololevelingtrad.online
# In Railway, set CLIENT_URL to the public frontend origin. If frontend and
# backend share one domain, use that same public origin.
# Optional: comma-separated extra browser origins allowed by CORS (staging, etc.)
# CORS_ORIGIN=
MONGODB_URI=mongodb+srv://<DB_USER>:<DB_PASSWORD>@<CLUSTER_HOST>/<DB_NAME>?retryWrites=true&w=majority
JWT_ACCESS_SECRET=<GENERATE_A_LONG_RANDOM_STRING>
JWT_REFRESH_SECRET=<GENERATE_A_LONG_RANDOM_STRING>
# Server-side pepper for OTP hashing (HMAC). Must be a long random string and
# MUST be set in production; keep it stable so outstanding OTPs still verify.
# OTP_HASH_SECRET=<GENERATE_A_LONG_RANDOM_STRING>
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=30
FIREBASE_PROJECT_ID=<FIREBASE_PROJECT_ID>
FIREBASE_CLIENT_EMAIL=<FIREBASE_CLIENT_EMAIL_SERVICE_ACCOUNT>
FIREBASE_PRIVATE_KEY=<FIREBASE_PRIVATE_KEY_WITH_LITERAL_NEWLINES>
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=<RAZORPAY_KEY_ID>
RAZORPAY_KEY_SECRET=<RAZORPAY_KEY_SECRET>
RAZORPAY_WEBHOOK_SECRET=<RAZORPAY_WEBHOOK_SECRET>
STRIPE_SECRET_KEY=<STRIPE_SECRET_KEY>
STRIPE_WEBHOOK_SECRET=<STRIPE_WEBHOOK_SECRET>

# ---------------------------------------------------------------------------
# Whop — official server-side SDK (@whop/sdk). Subscription checkout.
# Docs: https://docs.whop.com/developer/guides/webhooks
# ---------------------------------------------------------------------------
# Sandbox first. Leave WHOP_SANDBOX=true until the live merchant account,
# products, webhook endpoint and credentials are configured AND verified.
WHOP_COMPANY_API_KEY=<WHOP_COMPANY_API_KEY>       # apik_…
WHOP_COMPANY_ID=<WHOP_COMPANY_ID>                 # biz_…
WHOP_WEBHOOK_SECRET=<WHOP_WEBHOOK_SECRET>         # ws_…  (signing secret, verbatim incl. ws_)
WHOP_SANDBOX=true
# Public origin of this app — used for return URLs. No trailing slash.
APP_URL=http://localhost:5173
# Create in the Whop dashboard → Webhooks → endpoint URL:
#   {APP_URL}/api/webhooks/whop
# Subscribe to: payment.succeeded, payment.failed, payment.pending,
# payment.requires_action, refund.created, dispute.created, dispute.updated

# ---------------------------------------------------------------------------
# Real-money wallet — DISABLED BY DEFAULT ON PURPOSE (eligibility gate).
# ---------------------------------------------------------------------------
# Whop's "Prohibited Businesses" policy excludes "Non-fiat currencies and
# digital assets" and "Unregistered Financial Services" (payment facilitation /
# escrow), which covers funding a stored-value wallet. Keep this false until the
# provider confirms support IN WRITING for this merchant/product AND the
# applicable money-services licensing for your jurisdictions is addressed.
# Subscription checkout (SaaS) is unaffected by this gate.
WALLET_DEPOSITS_ENABLED=false
WALLET_CURRENCY=USD
WALLET_MIN_DEPOSIT_CENTS=500
WALLET_MAX_DEPOSIT_CENTS=50000
WALLET_DEPOSIT_EXPIRY_MINUTES=30
# Optional: override the user-facing explanation shown while gated off.
# WALLET_DEPOSITS_UNAVAILABLE_REASON=
# Whop checkout links for each top-up amount (only needed when deposits are on).
# Create one checkout link per amount in the Whop dashboard → Checkout links,
# then list "<cents>:<plan_…>" pairs. Provider ids come ONLY from your dashboard.
WHOP_DEPOSIT_PRODUCT_ID=<WHOP_DEPOSIT_PRODUCT_ID>   # prod_…
# WHOP_DEPOSIT_PLAN_IDS=2500:plan_xxxxxxxx,5000:plan_xxxxxxxx,10000:plan_xxxxxxxx

# Unified checkout (/checkout). All optional — shown with their code defaults.
# QUOTE_TTL_SECONDS=300          # Signed quote lifetime in seconds (300 = 5 min).
# CRYPTO_FEE_BPS=75              # Platform fee on crypto orders in basis points (75 = 0.75%).
# CHECKOUT_TAX_BPS=0             # Tax on checkout orders in basis points (0 = no tax line shown).
# CRYPTO_PURCHASE_MODE=disabled  # disabled | simulated. "simulated" completes without a real
                                 # provider charge and credits the paper wallet (always labelled
                                 # simulated). Real-fund crypto settlement stays disabled until a
                                 # licensed provider + merchant approval is in place.
# Market data (Stage 1): CoinGecko works without a key; add for higher limits.
# COINGECKO_API_KEY=
# CoinMarketCap optional (server-side only, never expose to frontend).
# CMC_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=<SMTP_USER_EMAIL>
SMTP_PASS=<SMTP_APP_PASSWORD>
SMTP_FROM="SoloLevelingTrad <julianmeta452@gmail.com>"
OTP_EXPIRY_MINUTES=10
OTP_COOLDOWN_SECONDS=60
# VideoSDK (calls / rooms / live sessions). Server-side only — never expose to frontend.
# Get keys from https://videosdk.live → Developer Settings. Leave blank to run in
# "unconfigured" mode (API responds 503 for provider-backed actions; app still boots).
VIDEOSDK_API_KEY=<VIDEOSDK_API_KEY>
VIDEOSDK_SECRET_KEY=<VIDEOSDK_SECRET_KEY>
VIDEOSDK_API_BASE_URL=https://api.videosdk.live
VIDEOSDK_TOKEN_TTL_SECONDS=3600
VIDEOSDK_MAX_PARTICIPANTS=50
