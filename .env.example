# Leave unset when frontend and backend share a Railway service (production
# defaults to the current site origin). For separate services, set this in the
# frontend service before building, e.g. https://<backend-domain>/api.
# VITE_API_URL=http://localhost:5000/api

# Firebase client (public identifiers only — safe to expose; secrets stay on backend)
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
REDIS_URL=
